# Clave de Gemini usada SOLO por scripts/generar-embeddings.mjs (build). Nunca se incluye en el bundle.
GEMINI_API_KEY=

# Opcional: clave por defecto para la app, en base64 (btoa). Queda en el bundle público: úsala solo si
# está restringida por dominio en Google Cloud y en capa gratuita o con presupuesto con tope.
# El admin puede sobreescribirla desde Configuración sin tocar este archivo.
VITE_GEMINI_API_KEY_B64=
VITE_GEMINI_MODELO=gemini-3.5-flash-lite
VITE_GEMINI_MODELO_EMBEDDINGS=gemini-embedding-2

# Respaldo opcional (Groq, API compatible con OpenAI), también en base64.
VITE_GROQ_API_KEY_B64=
VITE_GROQ_MODELO=llama-3.3-70b-versatile

# Para obtener el valor base64 de una clave: `npm run clave:base64` (lee GEMINI_API_KEY de este archivo).
