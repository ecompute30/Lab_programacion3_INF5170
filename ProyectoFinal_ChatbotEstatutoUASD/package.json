{
  "name": "chatbot-estatuto-uasd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "corpus": "node scripts/construir-corpus.mjs",
    "embeddings": "node --env-file-if-exists=.env scripts/generar-embeddings.mjs",
    "evaluar": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env scripts/evaluar-recuperacion.ts",
    "documento": "node scripts/generar-documento.mjs",
    "clave:base64": "node --env-file=.env scripts/clave-base64.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "dompurify": "^3.4.17",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.1.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "docx": "^9.12.0",
    "pdfjs-dist": "^6.4.299",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
