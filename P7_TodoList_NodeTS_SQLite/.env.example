# Modo de almacenamiento del frontend cuando corre contra este servidor Express.
# - api           -> usa el backend + SQLite (comportamiento por defecto)
# - localStorage  -> fuerza al cliente a guardar en el navegador aunque el
#                    backend esté disponible (útil para probar ese modo localmente)
#
# GitHub Pages (sitio estático, sin este servidor) ignora esta variable: ahí
# siempre se usa el valor fijo en public/config.js ("localStorage").
STORAGE_MODE=api
